---
import config from "virtual:config";
import * as z from "zod";
import {defaultPropsSchema, type DefaultProps} from "@dlcastillop/seo-in-astro/internals";
import Layout from "./Layout.astro"

const {baseUrl, defaultOgImg} = config;

const propsSchema = defaultPropsSchema.extend({
    ogImg: z.string().refine(
        (val) => {
            const isValidPath = z.string().startsWith("/").safeParse(val).success;
            const isValidUrl = z.url().safeParse(val).success;

            return isValidPath || isValidUrl;
        },
        {
            error: "ogImg must be either a route starting with '/' (e.g., /image.jpg) or a valid URL (e.g., https://example.com/image.jpg).",
        }
    ).default(defaultOgImg).optional(),
    scriptKey: z.string().default("jsonld-article").optional(),
    type: z.enum(["Article", "NewsArticle", "BlogPosting"]),
    headline: z.string().min(1, "headline must not be empty.").optional(),
    images: z.array(z.string().refine(
        (val) => {
            const isValidPath = z.string().startsWith("/").safeParse(val).success;
            const isValidUrl = z.url().safeParse(val).success;

            return isValidPath || isValidUrl;
        },
        {
            message: "images must be either a route starting with '/' (e.g., /image.jpg) or a valid URL (e.g., https://example.com/image.jpg).",
        }
    )),
    datePublished: z.date(),
    dateModified: z.date(),
    authors: z.array(
        z.object({
            name: z.string().min(1, "author name must not be empty."),
            url: z
                .url({
                    protocol: /^https?$/,
                    hostname: z.regexes.domain,
                    error: `Invalid author url.`,
                    normalize: true,
                })
        })
    ).min(1, "at least one author is required."),
});

interface Props extends DefaultProps {
    type: "Article" | "NewsArticle" | "BlogPosting"
    images: string[]
    datePublished: Date
    dateModified: Date
    authors: {
        name: string
        url: string
    }[]
    headline?: string | undefined
}

const result = propsSchema.safeParse(Astro.props);

if (!result.success) {
    throw new Error(result.error.issues[0].message);
}

const {
    title,
    description,
    ogImg,
    lang,
    scriptId,
    scriptKey,
    authors,
    dateModified,
    datePublished,
    headline,
    images,
    type
} = result.data;
let author;

if (authors.length === 1) {
    author = {
        "@type": "Person",
        ...authors[0],
    };
} else {
    author = authors.map((author) => {
        return {
            "@type": "Person",
            ...author,
        };
    });
}

const image = images.map((img) => {
    if (img.startsWith("/")) {
        return `${baseUrl}${img}`
    } else {
        return img
    }
})

const jsonLd = {
    "@context": "https://schema.org",
    "@type": type,
    headline: headline ? headline : title,
    image,
    datePublished: datePublished.toISOString(),
    dateModified: dateModified.toISOString(),
    author,
};
---

<Layout
        title={title}
        description={description}
        ogImg={ogImg}
        lang={lang}
        jsonLd={jsonLd}
        scriptId={scriptId}
        scriptKey={scriptKey}
>
    <slot/>
</Layout>