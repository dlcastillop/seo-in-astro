---
import config from "virtual:config";
import * as z from "zod";
import {stringifyJsonLd, defaultPropsSchema} from "@dlcastillop/seo-in-astro/internals";

const {siteName} = config;

const propsSchema = defaultPropsSchema.extend({
    scriptKey: z.string().optional(),
});

type Props = z.infer<typeof propsSchema>;

const result = propsSchema.safeParse(Astro.props);

if (!result.success) {
    throw new Error(result.error.issues[0].message);
}

const {title, description, ogImg, lang, jsonLd, scriptId, scriptKey} =
    result.data;
const url = Astro.url.href;
const jsonLdString =
    jsonLd === null || jsonLd === undefined ? undefined : stringifyJsonLd(jsonLd);
---

<!doctype html>
<html lang={lang}>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>

    <title>{title}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={url}/>

    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={url}/>
    <meta property="og:site_name" content={siteName}/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content={ogImg}/>

    <meta name="twitter:card" content="summary"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImg}/>

    {
        jsonLdString && (
            <script
                type="application/ld+json"
                id={scriptId || scriptKey}
                data-testid={scriptId}
                set:html={jsonLdString}
                />
        )
    }
</head>
<body>
<slot/>
</body>
</html>
