---
import * as z from "zod";
import Layout from "./Layout.astro";
import {
  defaultPropsSchema,
  jsonLdForFaq,
  type DefaultProps,
} from "@dlcastillop/seo-in-astro/internals";

const propsSchema = defaultPropsSchema.extend({
  ogImg: z.string().optional(),
  scriptId: z.string().default("jsonld-faq").optional(),
  faqs: z.array(
    z.object({
      question: z.string().min(1, "question must not be empty."),
      answer: z.string().min(1, "answer must not be empty."),
    })
  ),
});

interface Props extends DefaultProps {
  faqs: {
    question: string;
    answer: string;
  }[];
}

const result = propsSchema.safeParse(Astro.props);

if (!result.success) {
  throw new Error(result.error.issues[0].message);
}

const { title, description, ogImg, lang, scriptId, faqs } = result.data;

const jsonLd = jsonLdForFaq({ faqs });
---

<Layout
  title={title}
  description={description}
  ogImg={ogImg}
  lang={lang}
  jsonLd={jsonLd}
  scriptId={scriptId}
>
  <slot />
</Layout>
