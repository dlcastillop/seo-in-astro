---
import * as z from "zod";
import Layout from "./Layout.astro"
import {defaultPropsSchema} from "@dlcastillop/seo-in-astro/internals";

const propsSchema = defaultPropsSchema.extend({
    scriptKey: z.string().default("jsonld-faq").optional(),
    faqs: z.array(z.object({
        question: z.string().min(1, "question must not be empty."),
        answer: z.string().min(1, "answer must not be empty."),
    }))
});

interface Props {
    title: string
    description: string
    faqs: {
        question: string
        answer: string
    }[]
    ogImg?: string | undefined
    lang?: string | undefined
    jsonLd?: any
    scriptId?: string | undefined
    scriptKey?: string | undefined
}

const result = propsSchema.safeParse(Astro.props);

if (!result.success) {
    throw new Error(result.error.issues[0].message);
}

const {
    title,
    description,
    ogImg,
    lang,
    scriptId,
    scriptKey,
    faqs
} = Astro.props;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => {
        return {
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: {
                "@type": "Answer",
                text: faq.answer,
            },
        };
    }),
};
---

<Layout
        title={title}
        description={description}
        ogImg={ogImg}
        lang={lang}
        jsonLd={jsonLd}
        scriptId={scriptId}
        scriptKey={scriptKey}
/>
