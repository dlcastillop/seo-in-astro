---
import config from "virtual:config";
import * as z from "zod";
import Layout from "./Layout.astro";
import {defaultPropsSchema} from "@dlcastillop/seo-in-astro/internals";

const {baseUrl} = config;

const propsSchema = defaultPropsSchema.extend({
    scriptKey: z.string().default("jsonld-breadcrumb").optional(),
    itemList: z.array(z.object({
        name: z.string().min(1, "name must not be empty."),
        route: z.string().startsWith("/", {
            error: "route must start with '/' (e.g., /about).",
        }),
    }))
});

interface Props {
    title: string
    description: string
    itemList: {
        name: string
        route: string
    }[]
    ogImg?: string | undefined
    lang?: string | undefined
    jsonLd?: any
    scriptId?: string | undefined
    scriptKey?: string | undefined
}

const result = propsSchema.safeParse(Astro.props);

if (!result.success) {
    throw new Error(result.error.issues[0].message);
}

const {
    title,
    description,
    ogImg,
    lang,
    scriptId,
    scriptKey,
    itemList
} = Astro.props;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: itemList.map((itemList, key) => {
        return {
            "@type": "ListItem",
            position: key + 1,
            name: itemList.name,
            item: `${baseUrl}${itemList.route}`,
        };
    }),
};
---

<Layout
        title={title}
        description={description}
        ogImg={ogImg}
        lang={lang}
        jsonLd={jsonLd}
        scriptId={scriptId}
        scriptKey={scriptKey}
/>