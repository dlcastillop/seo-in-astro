---
import config from "virtual:config";
import * as z from "zod";
import Layout from "./Layout.astro";

const {defaultOgImg, baseUrl} = config;

const propsSchema = z.object({
    title: z.string().min(1, "title must not be empty."),
    description: z.string().min(1, "description must not be empty."),
    ogImg: z.string().refine(
        (val) => {
            const isValidPath = z.string().startsWith("/").safeParse(val).success;
            const isValidUrl = z.url().safeParse(val).success;

            return isValidPath || isValidUrl;
        },
        {
            message: "ogImg must be either a route starting with '/' (e.g., /image.jpg) or a valid URL (e.g., https://example.com/image.jpg).",
        }
    ).default(defaultOgImg).optional(),
    lang: z.string().default("en").optional(),
    scriptId: z.string().optional(),
    scriptKey: z.string().default("jsonld-breadcrumb").optional(),
    itemList: z.array(z.object({
        name: z.string(),
        route: z.string(),
    }))
});

type Props = z.infer<typeof propsSchema>;

const result = propsSchema.safeParse(Astro.props);

if (!result.success) {
    throw new Error(result.error.issues[0].message);
}

const {
    title,
    description,
    ogImg,
    lang,
    scriptId,
    scriptKey,
    itemList
} = result.data;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: itemList.map((itemList, key) => {
        return {
            "@type": "ListItem",
            position: key + 1,
            name: itemList.name,
            item: `${baseUrl}${itemList.route}`,
        };
    }),
};
---

<Layout
        title={title}
        description={description}
        ogImg={ogImg}
        lang={lang}
        jsonLd={jsonLd}
        scriptId={scriptId}
        scriptKey={scriptKey}
/>