---
import * as z from "zod";
import {stringifyJsonLd} from "@dlcastillop/seo-in-astro/internals";

const propsSchema = z.object({
    jsonLd: z.any(),
    scriptId: z.string().optional(),
    scriptKey: z.string().optional(),
});

type Props = z.infer<typeof propsSchema>;

const result = propsSchema.safeParse(Astro.props);

if (!result.success) {
    throw new Error(result.error.issues[0].message);
}

const {jsonLd, scriptId, scriptKey} = result.data;
const jsonLdString =
    jsonLd === null || jsonLd === undefined ? undefined : stringifyJsonLd(jsonLd);
---

{
    jsonLdString && (
    <script
            type="application/ld+json"
            id={scriptId || scriptKey}
            data-testid={scriptId}
            set:html={jsonLdString}
    />
        )
    }